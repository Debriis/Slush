EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Phone: use your computer's LAN IP, e.g. http://192.168.1.10:4000/api
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:4000/api
# Optional web-only override. Localhost web pages otherwise use localhost for local APIs.
EXPO_PUBLIC_WEB_API_URL=
# An allowed web or Expo Go redirect URL configured in Supabase Auth.
EXPO_PUBLIC_AUTH_REDIRECT_URL=
# Optional: Expo Go reset/confirmation URL. If blank, Expo Linking derives the current URL.
# Allow the generated exp://LAN_IP:PORT/--/reset-password URL in Supabase Auth settings.
EXPO_PUBLIC_NATIVE_AUTH_REDIRECT_URL=
