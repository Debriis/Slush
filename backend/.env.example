PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
CORS_ORIGINS=http://localhost:8081,http://localhost:8083
NODE_ENV=development
# Comma-separated Supabase user UUIDs of trusted, independent evidence reviewers.
# Leave empty to disable evidence review. Users cannot approve their own claims.
REVIEWER_USER_IDS=
