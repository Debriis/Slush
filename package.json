{
  "name": "slush-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "setup:env": "node scripts/setup-env.js",
    "config:check": "node scripts/check-config.js",
    "frontend": "npm run start --workspace frontend --",
    "web": "npm run web --workspace frontend --",
    "backend": "npm run dev --workspace backend",
    "dev": "node scripts/dev.js",
    "test": "node --test scripts/tests/*.test.js && npm test --workspace backend && npm test --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "check:dependencies": "npm run check:dependencies --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:validate": "npm run db:validate --workspace backend",
    "build": "npm run build --workspace frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:sync": "node scripts/sync-public-env.js",
    "services:check": "npm run services:check --workspace backend"
  }
}
